# Copy to .env (never commit .env). One file is read by the backend; the frontend gets the
# Google client ID from the backend at runtime, so no VITE_ variable is needed.
# Port 5432 busy (a Windows PostgreSQL is installed)? Use DB_PORT=5433 and port 5433 in DATABASE_URL.
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://agri:agri_dev_pw@localhost:5432/agriconnect
# Google Cloud Console > Google Auth Platform > Clients > Web application. Not a secret.
GOOGLE_OAUTH_CLIENT_ID=your-id.apps.googleusercontent.com
# Origins allowed to call the API with cookies (comma separated). The built site is served by the backend itself.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
# Set true only behind HTTPS (production) so the session cookie is Secure.
COOKIE_SECURE=false
# Later phases (placeholders only):
# Free key from https://data.gov.in (account > My Account). Used by: python -m app.prices.ingest run
DATA_GOV_IN_API_KEY=your-data-gov-in-key
# Free key from https://quickstats.nass.usda.gov/api. Used by: python -m app.prices.ingest nass
NASS_API_KEY=your-nass-key
# Free key from https://mymarketnews.ams.usda.gov (register, then My Profile). Used by: python -m app.prices.ingest probe-ams
MARS_API_KEY=your-mars-key
GEMINI_API_KEY=your-gemini-api-key

# While the app runs it re-fetches each price source (that has its key above) when its data is older than this many hours. 0 = off.
PRICE_REFRESH_HOURS=6
