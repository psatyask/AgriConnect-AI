# Copy to .env (never commit .env). One file is read by the backend; the frontend gets the
# Google client ID from the backend at runtime, so no VITE_ variable is needed.
DATABASE_URL=postgresql+psycopg://agri:agri_dev_pw@localhost:5432/agriconnect
# Google Cloud Console > Google Auth Platform > Clients > Web application. Not a secret.
GOOGLE_OAUTH_CLIENT_ID=your-id.apps.googleusercontent.com
# Origins allowed to call the API with cookies (comma separated). The built site is served by the backend itself.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
# Set true only behind HTTPS (production) so the session cookie is Secure.
COOKIE_SECURE=false
# Later phases (placeholders only):
GEMINI_API_KEY=your-gemini-api-key
